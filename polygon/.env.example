# Copy to .env and fill. Never commit the filled version.
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Deployment key. Use a hardware wallet or a keystore for anything touching mainnet;
# a raw private key here is acceptable for Amoy testnet only.
DEPLOYER_PRIVATE_KEY=
